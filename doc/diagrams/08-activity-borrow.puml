@startuml 08-activity-borrow
title Activity Diagram — Counter loan flow

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #34495E
  DiamondBackgroundColor #FEF9E7
  DiamondBorderColor #B7950B
}

|บรรณารักษ์|
start
:ค้นหาสมาชิกและสแกนบาร์โค้ดตัวเล่ม;

|ระบบ|
:โหลดสมาชิกและตัวเล่ม;
if (พบสมาชิกและตัวเล่ม?) then (ไม่พบ)
  :ตอบ 404;
  stop
else (พบ)
endif

if (สมาชิก ACTIVE?\n(BR-01)) then (ไม่)
  :ตอบ MEMBER_SUSPENDED;
  stop
else (ใช่)
endif

if (ค่าปรับค้างเกิน 100 บาท?\n(BR-02)) then (ใช่)
  :ตอบ UNPAID_FINE_EXCEEDED;
  stop
else (ไม่)
endif

if (เกินโควต้าตาม Tier?\n(BR-03)) then (เกิน)
  :ตอบ LOAN_QUOTA_EXCEEDED;
  stop
else (ไม่เกิน)
endif

if (ตัวเล่มยืมได้หรือไม่?\n(BR-04)) then (ไม่ได้)
  :ตอบ COPY_NOT_AVAILABLE;
  stop
else (ได้)
endif

if (มีชื่อซ้ำที่ยังไม่คืน\nหรือซ้ำในคำขอ? (BR-09)) then (ซ้ำ)
  :ตอบ BOOK_ALREADY_ON_LOAN;
  stop
else (ไม่ซ้ำ)
endif

:คำนวณ dueDate ตาม MemberTier (BR-05);
:สร้าง Loan และ LoanItem;
:บันทึกใน transaction;
:เปลี่ยนตัวเล่มเป็น ON_LOAN;
:ถ้าเป็นคิว READY ของผู้ยืม\nให้เปลี่ยน Reservation เป็น FULFILLED;

|บรรณารักษ์|
:แสดงรหัสใบยืมและกำหนดคืน;
stop

@enduml
