@startuml 12-component-diagram
title Component Diagram — LibraFlow

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam component {
  BackgroundColor #EAF2F8
  BorderColor #34495E
}
skinparam package {
  BackgroundColor #F7F9F9
  BorderColor #85929E
}

package "Client Tier" {
  [React SPA\n(Vite + Axios + Tailwind)] as UI
}

package "Application Tier — Spring Boot" {
  [Security Filter Chain\n(JWT)] as SEC
  [REST Controllers\n(Presentation)] as CTRL
  [Request / Response DTOs] as DTO
  [Service Interfaces + Implementations\n(Business Logic / Transactions)] as SVC
  [Mappers] as MAP
  [Design Pattern Components\n(Chain / State / Strategy / Observer / Template)] as PAT
  [Spring Data Repositories] as REPO
  [Global Exception Handler] as EXC
}

package "Data Tier" {
  database "PostgreSQL 16" as DB
}

interface "HTTPS / JSON" as API
interface "JDBC" as JDBC

UI -( API
API - SEC
SEC --> CTRL : authenticated request
CTRL --> DTO : bind request / return response
CTRL --> SVC : delegate
SVC --> MAP : map domain responses
MAP --> DTO
SVC --> PAT : apply domain rules
SVC --> REPO : query / persist
CTRL ..> EXC : exceptions
REPO -( JDBC
JDBC - DB

note right of CTRL
  Controllers do not inject repositories.
  User management changes go through
  UserManagementService.
end note

note bottom of PAT
  Observer reservation updates run after commit.
  Email/SMS providers are not connected.
end note

@enduml
