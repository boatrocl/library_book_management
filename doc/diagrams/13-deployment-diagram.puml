@startuml 13-deployment-diagram
title Deployment topology and CI/CD boundaries — LibraFlow

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam node {
  BackgroundColor #EAF2F8
  BorderColor #34495E
}
skinparam cloud {
  BackgroundColor #F7F9F9
  BorderColor #85929E
}

node "User" as CLIENT {
  artifact "Web browser" as BROWSER
}

cloud "Vercel" as VERCEL {
  artifact "React SPA\nlibrary-book-management-alpha.vercel.app" as FRONTEND
}

cloud "Render" as RENDER {
  artifact "Spring Boot API\nlibrary-book-management-ybt2.onrender.com" as BACKEND
}

cloud "Neon" as NEON {
  database "PostgreSQL\nlibraflow" as DB
  artifact "Database branch configured by DB_URL" as NEON_BRANCH
}

cloud "GitHub" as GITHUB {
  artifact "main / develop / task branches" as REPO
  node "GitHub Actions" as CI {
    artifact "Backend CI: Maven clean verify" as BACKEND_CI
    artifact "Frontend CI: npm ci, lint, build" as FRONTEND_CI
    artifact "Production smoke check: SPA routes and public API" as PROD_SMOKE
    artifact "CD Demo: build, validate, publish to Pages" as DEMO_CI_CD
  }
}

cloud "GitHub Pages" as PAGES {
  artifact "CD teaching demo page\n(not the LibraFlow app)" as DEMO_PAGE
}

BROWSER --> FRONTEND : HTTPS
BROWSER --> BACKEND : HTTPS / REST / JWT
BACKEND --> DB : JDBC over TLS
NEON_BRANCH -- DB
REPO --> CI : push / pull request
DEMO_CI_CD --> PAGES : tested demo artifact
VERCEL --> PROD_SMOKE
PROD_SMOKE --> FRONTEND
PROD_SMOKE --> BACKEND

note right of REPO
  Intended release flow:
  task branch -> reviewed PR -> develop -> main
end note

note bottom of CI
  Backend and frontend workflows are CI only.
  On successful Production deployment, the smoke check
  GETs frontend routes, OpenAPI, and the public catalog.
  It verifies the app after deployment; it does not deploy it.
  CD Demo publishes a separate static teaching page;
  it does not deploy the app to Vercel or Render.
end note

note bottom of RENDER
  Confirm actual branch and environment settings
  in the provider dashboard.
end note

note bottom of DB
  A database branch name does not prove which
  connection Render uses. Check DB_URL privately.
end note

@enduml
