@startuml 04-class-diagram
title Class Diagram — Core services and implemented patterns

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam package {
  BackgroundColor #F7F9F9
  BorderColor #85929E
}
left to right direction

package "Loan service" {
  class LoanServiceImpl
  interface LoanRepository
  class LoanStateFactory
}

package "Borrow checks — Chain of Responsibility" {
  interface BorrowRule {
    + order() : int
    + check(BorrowContext) : void
  }
  class BorrowContext
  class MemberStatusRule
  class UnpaidFineRule
  class LoanQuotaRule
  class CopyAvailabilityRule
  class NoDuplicateTitleLoanRule
}

package "Loan states" {
  interface LoanState {
    + status() : LoanStatus
    + onReturn(Loan, LoanItem) : void
    + onRenew(Loan) : void
  }
  class ActiveState
  class OverdueState
  class ReturnedState
  class LostState
}

package "Fine calculation — Strategy" {
  interface FineService
  class FineServiceImpl
  interface FineCalculationStrategy {
    + getApplicableMemberTier() : MemberTier
    + calculateFine(int) : BigDecimal
  }
  class StudentFineStrategy
  class StaffFineStrategy
  class ExternalFineStrategy
}

package "Reservation queue — Observer" {
  class BookReturnedEvent
  class ReservationNotificationListener
  interface ReservationRepository
  interface BookCopyRepository
  class ReservationServiceImpl
  class ReservationScheduler
}

package "Report generation — Template Method" {
  class ReportController
  interface ReportService
  class ReportServiceImpl
  interface ReportFileGenerator
  abstract class AbstractReportGenerator
  class CsvReportGenerator
  class PdfReportGenerator
}

package "Domain entities" {
  class Loan
  class LoanItem
  class Fine
  class Book
  class BookCopy
  class Reservation
}

LoanServiceImpl ..> LoanRepository : persist
LoanServiceImpl --> "1..*" BorrowRule : sort by order()
BorrowRule <|.. MemberStatusRule
BorrowRule <|.. UnpaidFineRule
BorrowRule <|.. LoanQuotaRule
BorrowRule <|.. CopyAvailabilityRule
BorrowRule <|.. NoDuplicateTitleLoanRule
BorrowRule ..> BorrowContext
NoDuplicateTitleLoanRule ..> LoanRepository

LoanServiceImpl ..> LoanStateFactory
LoanStateFactory ..> LoanState : selects by status
LoanState <|.. ActiveState
LoanState <|.. OverdueState
LoanState <|.. ReturnedState
LoanState <|.. LostState

LoanServiceImpl ..> FineService
FineService <|.. FineServiceImpl
FineServiceImpl o--> "1..*" FineCalculationStrategy : select by tier
FineCalculationStrategy <|.. StudentFineStrategy
FineCalculationStrategy <|.. StaffFineStrategy
FineCalculationStrategy <|.. ExternalFineStrategy

LoanServiceImpl ..> BookReturnedEvent : publishes after return
BookReturnedEvent <.. ReservationNotificationListener : handles after commit
ReservationNotificationListener ..> ReservationRepository
ReservationNotificationListener ..> BookCopyRepository
ReservationServiceImpl ..> ReservationRepository : cancel/expire
ReservationServiceImpl ..> BookCopyRepository : release copies
ReservationServiceImpl ..> BookReturnedEvent : publish available copy
ReservationScheduler ..> ReservationServiceImpl : expire READY after 48 hours

ReportController ..> ReportService : HTTP boundary
ReportService <|.. ReportServiceImpl
ReportServiceImpl ..> ReportFileGenerator : CSV/PDF collaborators
ReportFileGenerator <|.. AbstractReportGenerator
AbstractReportGenerator <|-- CsvReportGenerator
AbstractReportGenerator <|-- PdfReportGenerator

Loan "1" *--> "1..*" LoanItem
LoanItem "1" --> "0..1" Fine
LoanItem "*" --> "1" BookCopy
Reservation "*" --> "1" Book
Reservation "*" --> "0..1" BookCopy : assigned while READY
Book "1" --> "1..*" BookCopy

note bottom of ReportServiceImpl
  Controller delegates to service.
  It does not select a generator directly.
end note

note bottom of FineServiceImpl
  Fine is recorded on return for overdue items.
  LOST copies receive a replacement-price charge.
end note

@enduml
