@startuml 04-class-diagram
title Class Diagram — Core services and implemented design patterns

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam package {
  BackgroundColor #F7F9F9
  BorderColor #85929E
}

left to right direction

package "Loan orchestration" {
  class LoanServiceImpl {
    + borrow(BorrowRequest) : LoanResponse
    + returnBook(Long) : LoanResponse
    + renewLoan(Long) : LoanResponse
  }
  interface LoanRepository
  class LoanStateFactory
}

package "Chain of Responsibility" {
  interface BorrowRule {
    + order() : int
    + check(BorrowContext) : void
  }
  class BorrowContext
  class MemberStatusRule
  class UnpaidFineRule
  class LoanQuotaRule
  class CopyAvailabilityRule
}

package "State" {
  interface LoanState {
    + status() : LoanStatus
    + onReturn(Loan, LoanItem) : void
    + onRenew(Loan) : void
  }
  class ActiveState
  class OverdueState
  class ReturnedState
  class LostState
}

package "Fine calculation — Strategy" {
  interface FineService {
    + generateFine(LoanItem, int, MemberTier) : Fine
    + generateLostBookFine(LoanItem, int) : Fine
  }
  class FineServiceImpl
  interface FineCalculationStrategy {
    + getApplicableMemberTier() : MemberTier
    + calculateFine(int) : BigDecimal
  }
  class StudentFineStrategy
  class StaffFineStrategy
  class ExternalFineStrategy
}

package "Reservation notification — Observer" {
  class BookCopyAvailableEvent
  class BookReturnedEvent
  class ReservationNotificationListener {
    + onBookCopyAvailable(BookCopyAvailableEvent) : void
    --
    AFTER_COMMIT
    REQUIRES_NEW
  }
  interface ReservationRepository
  interface BookCopyRepository
  class ReservationServiceImpl
  class ReservationScheduler
}

package "Reports — Template Method" {
  class ReportController
  abstract class AbstractReportGenerator {
    + generate(ReportRequest) : byte[]
    # render(List<ReportRow>) : byte[]
  }
  class CsvReportGenerator
  class PdfReportGenerator
}

package "Relevant domain entities" {
  class Loan
  class LoanItem
  class Fine
  class Book
  class BookCopy
  class Reservation
}

LoanServiceImpl ..> LoanRepository : persists loans
LoanServiceImpl --> "1..*" BorrowRule : runs in order()
BorrowRule <|.. MemberStatusRule
BorrowRule <|.. UnpaidFineRule
BorrowRule <|.. LoanQuotaRule
BorrowRule <|.. CopyAvailabilityRule
BorrowRule ..> BorrowContext

LoanServiceImpl ..> LoanStateFactory
LoanStateFactory ..> LoanState : selects by LoanStatus
LoanState <|.. ActiveState
LoanState <|.. OverdueState
LoanState <|.. ReturnedState
LoanState <|.. LostState

LoanServiceImpl ..> FineService
FineService <|.. FineServiceImpl
FineServiceImpl o--> "1..*" FineCalculationStrategy : selects by MemberTier
FineCalculationStrategy <|.. StudentFineStrategy
FineCalculationStrategy <|.. StaffFineStrategy
FineCalculationStrategy <|.. ExternalFineStrategy

LoanServiceImpl ..> BookReturnedEvent : publishes after return
BookCopyAvailableEvent <|-- BookReturnedEvent
BookCopyAvailableEvent <.. ReservationNotificationListener : handles after commit
ReservationNotificationListener ..> ReservationRepository : marks first WAITING as READY
ReservationNotificationListener ..> BookCopyRepository : changes copy to RESERVED
ReservationServiceImpl ..> ReservationRepository : cancel and expire queue entries
ReservationServiceImpl ..> BookCopyRepository : release reserved copies
ReservationServiceImpl ..> BookCopyAvailableEvent : publish released copy
ReservationScheduler ..> ReservationServiceImpl : expire after 48 hours

ReportController ..> AbstractReportGenerator : selects CSV or PDF
AbstractReportGenerator <|-- CsvReportGenerator
AbstractReportGenerator <|-- PdfReportGenerator

Loan "1" *--> "1..*" LoanItem
LoanItem "1" --> "0..1" Fine
LoanItem "*" --> "1" BookCopy
Reservation "*" --> "1" Book : reservation is for a title
Reservation "*" --> "0..1" BookCopy : assigned while READY
Book "1" --> "1..*" BookCopy

note bottom of FineServiceImpl
  STUDENT: 3 baht/day; STAFF: 5 baht/day, capped at 300;
  EXTERNAL: 10 baht/day. LOST items are charged the full book price.
end note

@enduml
