@startuml 05-sequence-borrow
title Sequence Diagram #1 — สมาชิกยืมหนังสือจากหน้าแคตตาล็อก

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ArrowColor #2E4053
  LifeLineBorderColor #85929E
  ParticipantBorderColor #34495E
  ParticipantBackgroundColor #EAF2F8
}
autonumber

actor "สมาชิก" as MEMBER
participant "LoanController" as C
participant "LoanServiceImpl" as S
participant "UserRepository" as UR
participant "BookRepository" as BR
participant "BookCopyRepository" as CR
participant "ReservationRepository" as RR
collections "BorrowRule chain\n(Chain of Responsibility)" as R
participant "LoanRepository" as LR
participant "LoanMapper" as M
database "PostgreSQL" as DB

MEMBER -> C : POST /api/v1/loans/self\n{bookId, termsAccepted: true} + Bearer JWT
activate C
C -> C : @Valid MemberBorrowRequest\n+ ตรวจ ROLE_MEMBER
C -> S : borrowForMember(jwtSubject, request)
activate S
S -> UR : findByUsername(jwtSubject)
UR -> DB : SELECT member by username
DB --> UR : User
UR --> S : User
S -> BR : existsById(bookId)
BR -> DB : ตรวจหนังสือ
DB --> BR : exists
BR --> S : true
S -> CR : เลือก AVAILABLE copy\nพร้อม PESSIMISTIC_WRITE lock
CR -> DB : SELECT ... WHERE book_id=?\nAND status='AVAILABLE' ORDER BY barcode\nLIMIT 1 FOR UPDATE
DB --> CR : BookCopy
CR --> S : BookCopy ที่ถูกล็อก
S -> S : สร้าง BorrowRequest(memberId, barcode)
S -> S : borrow(request)

S -> CR : findByBarcodeIn(barcodes)
activate CR
CR -> DB : SELECT ... FROM book_copies\nWHERE barcode IN (...) FOR UPDATE
DB --> CR : rows
CR --> S : List<BookCopy>
deactivate CR

loop สำหรับ copy สถานะ RESERVED
  S -> RR : find READY reservation\nby memberId + reservedCopyId + expiresAt
  RR -> DB : SELECT reservation ที่ยังไม่หมดอายุ
  DB --> RR : Reservation หรือไม่พบ
  RR --> S : reservation ของเจ้าของคิว (ถ้ามี)
end

S -> S : สร้าง BorrowContext(member, copies, reservations)

group ตรวจสอบสิทธิ์ตามลำดับกฎ
  S -> R : check(ctx)
  activate R
  R -> R : MemberStatusRule (BR-01)
  R -> R : UnpaidFineRule (BR-02)
  R -> R : LoanQuotaRule (BR-03)
  R -> R : CopyAvailabilityRule (BR-04)
end

alt ไม่ผ่านกฎข้อใดข้อหนึ่ง
  R --> S : throw BusinessException(errorCode)
  deactivate R
  S --> C : propagate exception
  C -> C : @RestControllerAdvice จับ
  C --> MEMBER : 409 Conflict + ErrorResponse
else ผ่านทุกกฎ
  R --> S : OK
  S -> S : คำนวณ dueDate ตาม MemberTier (BR-05)
  S -> S : สร้าง Loan + LoanItem ทั้งหมด
  S -> S : ตั้ง BookCopy เป็น ON_LOAN
  opt copy ถูกกันให้ผู้ยืม
    S -> RR : mark reservation FULFILLED
    RR -> DB : UPDATE reservations SET status='FULFILLED'
  end
  S -> LR : save(loan)
  activate LR
  LR -> DB : INSERT INTO loans\nINSERT INTO loan_items\nUPDATE book_copies SET status='ON_LOAN'
  DB --> LR : generated ids
  LR --> S : Loan (persisted)
  deactivate LR

  S -> M : toResponse(loan)
  activate M
  M --> S : LoanResponse
  deactivate M

  S --> C : LoanResponse
  deactivate S
  C --> MEMBER : 201 Created + LoanResponse\n(Location: /api/v1/loans/{id})
end
deactivate C

note over S
  @Transactional ครอบทั้งเมธอด
  หากขั้นตอนใดล้มเหลว rollback ทั้งหมด
end note

@enduml
