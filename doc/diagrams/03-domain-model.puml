@startuml 03-domain-model
title Domain Model — LibraFlow

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #34495E
  ArrowColor #2E4053
}
hide methods

class User {
  username
  email
  role : UserRole
  active : boolean
  memberTier
}

class UserProfile {
  firstName
  lastName
  phoneNumber
  address
}

class Category {
  name
  description
}

class Publisher {
  name
  country
}

class Author {
  fullName
  nationality
}

class Book {
  isbn
  title
  publishYear
  price
}

class BookCopy {
  barcode
  status : BookCopyStatus
  shelfLocation
}

class Loan {
  loanCode
  loanDate
  status : LoanStatus
}

class LoanItem {
  dueDate
  returnedAt
  renewCount
}

class Fine {
  amount
  overdueDays
  status : FineStatus
  paidAt
}

class Reservation {
  reservedAt
  expiresAt
  status : ReservationStatus
}

User "1" -- "1" UserProfile : profile
User "1" -- "0..*" Loan : borrows
User "1" -- "0..*" Reservation : places
Category "1" -- "0..*" Book : classifies
Publisher "1" -- "0..*" Book : publishes
Book "0..*" -- "1..*" Author : written by
Book "1" -- "0..*" BookCopy : physical copies
Book "1" -- "0..*" Reservation : reserved title
Loan "1" -- "1..*" LoanItem : contains
BookCopy "1" -- "0..*" LoanItem : borrowed copy
LoanItem "1" -- "0..1" Fine : may incur

note right of User
  Account activity is the isActive boolean.
  memberTier belongs to User, not UserProfile.
end note

note right of UserProfile
  user_id is both primary key
  and foreign key to User.
end note

note bottom of Book
  Book is the catalog title (ISBN).
  BookCopy is a physical item (barcode).
end note

@enduml
