@startuml 09-state-loan
title State Diagram — Loan

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam state {
  BackgroundColor #EAF2F8
  BorderColor #34495E
  ArrowColor #2E4053
}

[*] --> ACTIVE : checkout committed

state ACTIVE {
  ACTIVE : entry / dueDate from MemberTier (BR-05)
}

state OVERDUE {
  OVERDUE : entry / scheduler detects today > dueDate
}

state RETURNED {
  RETURNED : when every item in the loan is returned
  RETURNED : publish BookReturnedEvent for each returned copy
}

state LOST {
  LOST : scheduler detects overdueDays > 60 (BR-08)
  LOST : create replacement-price charge
}

ACTIVE --> ACTIVE : renew()\n[renewCount < 2 and no WAITING reservation] (BR-06)
ACTIVE --> OVERDUE : scheduled status check\n[today > dueDate]
ACTIVE --> RETURNED : returnBook()\n[all items now returned]

OVERDUE --> RETURNED : returnBook()\n[all items now returned; calculate fine on return]
OVERDUE --> LOST : scheduled status check\n[overdueDays > 60] (BR-08)
LOST --> RETURNED : returnBook()\n[all lost items recovered/recorded returned]

RETURNED --> [*]

note right of OVERDUE
  The scheduler updates loan state.
  It does not add a daily fine balance.
end note

note left of LOST
  Renewal is rejected for LOST loans.
  Fine charges are recorded by the return/scheduler flow.
end note

@enduml
