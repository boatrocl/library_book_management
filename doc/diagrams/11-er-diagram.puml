@startuml 11-er-diagram
title ER Diagram — LibraFlow schema (V1–V10)

skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods

entity "users" as users {
  * id : BIGSERIAL <<PK>>
  --
  * username : VARCHAR(50) <<UK>>
  * password_hash : VARCHAR(255)
  * email : VARCHAR(100) <<UK>>
  is_active : BOOLEAN = TRUE
  created_at : TIMESTAMP = CURRENT_TIMESTAMP
  * role : VARCHAR(20) = MEMBER
  member_tier : VARCHAR(20) = STUDENT
}

entity "user_profiles" as user_profiles {
  * user_id : BIGINT <<PK, FK>>
  --
  * first_name : VARCHAR(100)
  * last_name : VARCHAR(100)
  phone_number : VARCHAR(20)
  address : TEXT
}

entity "categories" as categories {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(80) <<UK>>
  description : VARCHAR(255)
}

entity "publishers" as publishers {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(120) <<UK>>
  country : VARCHAR(60)
}

entity "authors" as authors {
  * id : BIGSERIAL <<PK>>
  --
  * full_name : VARCHAR(120) <<IDX>>
  nationality : VARCHAR(60)
  biography : TEXT
}

entity "books" as books {
  * id : BIGSERIAL <<PK>>
  --
  * isbn : VARCHAR(20) <<UK>>
  * title : VARCHAR(200) <<IDX>>
  publish_year : INT
  price : NUMERIC(10,2)
  * category_id : BIGINT <<FK, IDX>>
  * publisher_id : BIGINT <<FK, IDX>>
  * created_at : TIMESTAMP = now()
}

entity "book_authors" as book_authors {
  * book_id : BIGINT <<PK, FK>>
  * author_id : BIGINT <<PK, FK>>
}

entity "book_copies" as book_copies {
  * id : BIGSERIAL <<PK>>
  --
  * barcode : VARCHAR(30) <<UK>>
  * book_id : BIGINT <<FK>>
  * status : VARCHAR(20) <<CHECK>>
  shelf_location : VARCHAR(30)
  * acquired_at : DATE
}

entity "loans" as loans {
  * id : BIGSERIAL <<PK>>
  --
  * loan_code : VARCHAR(20) <<UK>>
  * user_id : BIGINT <<FK, IDX>>
  librarian_id : BIGINT <<FK>>
  * loan_date : TIMESTAMP = CURRENT_TIMESTAMP
  * status : VARCHAR(20) <<CHECK, IDX>>
}

entity "loan_items" as loan_items {
  * id : BIGSERIAL <<PK>>
  --
  * loan_id : BIGINT <<FK, IDX>>
  * book_copy_id : BIGINT <<FK, IDX>>
  * due_date : DATE <<IDX>>
  returned_at : DATE
  * renew_count : SMALLINT = 0 <<CHECK 0..2>>
}

entity "fines" as fines {
  * id : BIGSERIAL <<PK>>
  --
  * loan_item_id : BIGINT <<UK, FK>>
  * amount : NUMERIC(10,2)
  * overdue_days : INT
  * status : VARCHAR(20) <<CHECK: UNPAID, PAID, WAIVED>>
  * created_at : TIMESTAMP = CURRENT_TIMESTAMP
  paid_at : TIMESTAMP
}

entity "reservations" as reservations {
  * id : BIGSERIAL <<PK>>
  --
  * user_id : BIGINT <<FK, IDX>>
  * book_id : BIGINT <<FK, IDX>>
  reserved_copy_id : BIGINT <<FK, IDX>>
  * reserved_at : TIMESTAMP = CURRENT_TIMESTAMP
  expires_at : TIMESTAMP
  * status : VARCHAR(20) <<CHECK>>
}

users ||--|| user_profiles : PK is also FK
users ||--o{ loans : borrower
users |o--o{ loans : librarian
users ||--o{ reservations
categories ||--o{ books
publishers ||--o{ books
books ||--o{ book_copies
books ||--o{ reservations
book_copies |o--o{ reservations : held copy
books ||--o{ book_authors
authors ||--o{ book_authors
loans ||--o{ loan_items
book_copies ||--o{ loan_items
loan_items ||--o| fines

note bottom of fines
  V5 creates the table and unique loan_item_id.
  V8 adds the foreign key.
  V10 adds and validates ck_fines_status.
end note

note bottom of reservations
  V8 adds user_id and book_id foreign keys.
  V9 assigns a copy and expiry to READY reservations.
end note

@enduml
